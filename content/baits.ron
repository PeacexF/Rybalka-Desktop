// Наживки и приманки. `kind`: Natural — живая/растительная наживка, Lure — искусственная приманка.
// price — цена пачки из pack штук (наживка — порции), rank — требуемый разряд.
[
    (id: "worm", name: "Червь", kind: Natural, price: 20, pack: 20),
    (id: "maggot", name: "Опарыш", kind: Natural, price: 25, pack: 20),
    (id: "bloodworm", name: "Мотыль", kind: Natural, price: 35, pack: 20, rank: 1),
    (id: "bread", name: "Хлеб", kind: Natural, price: 10, pack: 20),
    (id: "corn", name: "Кукуруза", kind: Natural, price: 30, pack: 20, rank: 1),
    (id: "barley", name: "Перловка", kind: Natural, price: 20, pack: 20, rank: 1),

    // Приманки. speed — рабочая скорость проводки (м/с), depth — глубина хода при проводке,
    // sink_mps — вертикальная скорость на паузе (+ тонет, − всплывает), pause — уловистость на паузе.
    (
        id: "spinner",
        name: "Вертушка №2",
        kind: Lure,
        price: 90,
        lure: Some((speed: (min: 0.5, max: 0.9), depth: 0.8, sink_mps: 0.3, pause: 0.15)),
    ),
    (
        id: "spoon",
        name: "Колебалка",
        kind: Lure,
        price: 120,
        rank: 1,
        lure: Some((speed: (min: 0.6, max: 1.1), depth: 1.6, sink_mps: 0.7, pause: 0.35)),
    ),
    (
        id: "wobbler",
        name: "Воблер-минноу",
        kind: Lure,
        price: 320,
        rank: 2,
        lure: Some((speed: (min: 0.4, max: 0.9), depth: 1.2, sink_mps: -0.15, pause: 0.6)),
    ),
    (
        id: "jig",
        name: "Джиг с твистером",
        kind: Lure,
        price: 60,
        rank: 1,
        lure: Some((speed: (min: 0.3, max: 0.6), depth: 0.3, sink_mps: 0.9, pause: 1.1)),
    ),
]
