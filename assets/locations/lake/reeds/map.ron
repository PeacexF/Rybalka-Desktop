// Water map spec for lake/reeds. Rebuild with:
//   cargo run -p rybalka-devtools --release --bin gen_map -- \
//     assets/locations/lake/reeds/map.ron assets/locations/lake/reeds/map.png
// Coordinates are normalized to the background image (0..1).
(
    size: (960, 540),
    // Must match content/locations/lake.ron.
    view: (horizonY: 0.525, shoreY: 1.0, nearM: 3.0),
    water: [[
        (0.30, 0.535), (0.45, 0.535), (0.60, 0.537), (0.62, 0.548), (0.66, 0.56),
        (0.72, 0.568), (0.8, 0.575), (0.9, 0.585), (1.0, 0.595), (1.0, 1.0),
        (0.29, 1.0), (0.30, 0.8),
    ]],
    depth: (near: 0.6, far: 4.5, far_at_m: 45.0, noise: 0.35, sand_within_m: 0.0),
    default_zone: 1,
    features: [
        // Sedge shallows in front.
        (
            shape: Polygon([(0.29, 1.0), (0.30, 0.64), (1.0, 0.64), (1.0, 1.0)]),
            soft: 0.05,
            depth: Some(Set(0.7)),
            zone: Some(2),
            bottom: Some(Weed),
        ),
        // Under the right bank: fallen trees in the reflection.
        (
            shape: Polygon([(0.64, 0.56), (1.0, 0.595), (1.0, 0.8), (0.75, 0.66)]),
            soft: 0.03,
            depth: Some(Set(1.6)),
            zone: Some(3),
            bottom: Some(Snag),
        ),
        // The deep middle of the lake.
        (
            shape: Ellipse(cx: 0.45, cy: 0.55, rx: 0.17, ry: 0.016),
            soft: 0.01,
            depth: Some(Add(2.5)),
            zone: Some(4),
        ),
    ],
)
